        "signature": { "signed": true, "teamId": null, "apple": true } }, "expect": "bad" },
    { "label": "malicious", "family": "Shlayer/Bundlore", "note": "random label, payload in hidden folder under /Users/Shared",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.mcpzqe7k2.agent.plist", "label": "com.mcpzqe7k2.agent",
        "program": "/Users/Shared/.mcpzqe7k2/mcpzqe", "runAtLoad": true,
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
    { "label": "malicious", "family": "EvilQuest", "note": "Apple-impersonating label and binary name in the user Library",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.apple.questd.plist", "label": "com.apple.questd",
        "program": "/Users/u/Library/AppQuest/com.apple.questd", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
    { "label": "malicious", "family": "EvilQuest", "note": "root daemon twin",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.apple.questd.plist", "label": "com.apple.questd",
        "program": "/Library/AppQuest/com.apple.questd", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
    { "label": "malicious", "family": "cryptominer", "note": "root daemon runs a bash script from root's home",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.startup.plist", "label": "com.startup",
