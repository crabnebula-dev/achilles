    { "label": "benign", "note": "1Password browser bridge into Chrome",
      "item": { "kind": { "type": "browserBridge", "browser": "Chrome" }, "source": "/Users/u/Library/Application Support/Google/Chrome/NativeMessagingHosts/com.1password.1password.json", "label": "com.1password.1password",
