        "signature": { "signed": true, "teamId": "2BUA8C4S2C", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Leftover from an uninstalled app: program gone",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.oldvendor.syncer.plist", "label": "com.oldvendor.syncer",
        "program": "/Applications/OldVendor Sync.app/Contents/MacOS/syncer", "programExists": false, "signature": null }, "expect": "normal" },
    { "label": "benign", "note": "A developer's own local debug build registered as a login item",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/Tchap.plist", "label": "Tchap",
        "program": "/Users/u/git/tchap-desktop/src-tauri/target/debug/tchap-desktop",
        "signature": { "signed": true, "teamId": null, "apple": false } }, "expect": "questionable" },

    { "label": "malicious", "family": "Adload", "note": "product-like name, payload in a hidden Application Support folder, unsigned, kept alive",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.ActivityInputd.service.plist", "label": "com.ActivityInputd.service",
        "program": "/Users/u/Library/Application Support/.ActivityInputd/ActivityInputd", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
    { "label": "malicious", "family": "Adload", "note": "root daemon variant",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.TrustedSearchDaemon.system.plist", "label": "com.TrustedSearchDaemon.system",
        "program": "/Library/Application Support/.TrustedSearch/TrustedSearchDaemon", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
    { "label": "malicious", "family": "Silver Sparrow", "note": "agent re-runs a shell one-liner that downloads and executes",
