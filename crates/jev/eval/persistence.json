        "program": "/Library/Application Support/PDF Converter/helper", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": true, "teamId": "7XQ2K9M4PL", "apple": false } }, "expect": "questionable", "hard": true }
  ]
}
