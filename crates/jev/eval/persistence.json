        "signature": { "signed": true, "teamId": null, "apple": true } }, "expect": "bad" },
    { "label": "malicious", "family": "Pirrit", "note": "Developer-ID-signed adware daemon with a plausible name; no installed app shares its team",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.KeyboardLayoutService.agent.plist", "label": "com.KeyboardLayoutService.agent",
        "program": "/Library/Application Support/KeyboardLayoutService/KeyboardLayoutService", "runAtLoad": true, "keepAlive": true,
        "signature": { "signed": true, "teamId": "ZQ3P8N2LM4", "apple": false } }, "expect": "questionable", "hard": true },
    { "label": "malicious", "family": "browser adware", "note": "unsigned native-messaging host for a search-hijacking extension",
      "item": { "kind": { "type": "browserBridge", "browser": "Chrome" }, "source": "/Users/u/Library/Application Support/Google/Chrome/NativeMessagingHosts/com.searchmine.native.json", "label": "com.searchmine.native",
        "program": "/Users/u/Library/Application Support/SearchMine/smhost",
        "signature": { "signed": false, "teamId": null, "apple": false } }, "expect": "bad" },
