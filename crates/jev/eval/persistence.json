        "program": "/Applications/Cloudflare WARP.app/Contents/Resources/CloudflareWARP", "keepAlive": true, "runAtLoad": true,
        "signature": { "signed": true, "teamId": "68WVV388M8", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "OneDrive updater daemon inside the bundle",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.microsoft.OneDriveUpdaterDaemon.plist", "label": "com.microsoft.OneDriveUpdaterDaemon",
