{
  "about": "Labelled persistence items for the behaviour watchdog. Benign items mirror real launchd/native-messaging registrations seen on a developer Mac. Malicious items are SYNTHETIC: their shape (location, launcher, naming, signing) is modelled on publicly documented persistence of the named macOS families, but labels, paths and team IDs are invented — they are not IOCs. 'expect' is the verdict a good watchdog should reach; 'hard' marks cases deterministic rules are not expected to catch.",
  "apps": [
    { "name": "Google Chrome", "bundleId": "com.google.Chrome", "path": "/Applications/Google Chrome.app", "teamId": "EQHXZ8M8AV" },
    { "name": "Microsoft Word", "bundleId": "com.microsoft.Word", "path": "/Applications/Microsoft Word.app", "teamId": "UBF8T346G9" },
    { "name": "Microsoft Excel", "bundleId": "com.microsoft.Excel", "path": "/Applications/Microsoft Excel.app", "teamId": "UBF8T346G9" },
    { "name": "OneDrive", "bundleId": "com.microsoft.OneDrive", "path": "/Applications/OneDrive.app", "teamId": "UBF8T346G9" },
    { "name": "zoom.us", "bundleId": "us.zoom.xos", "path": "/Applications/zoom.us.app", "teamId": "BJ4HAAB9B3" },
    { "name": "Little Snitch", "bundleId": "at.obdev.littlesnitch", "path": "/Applications/Little Snitch.app", "teamId": "MLZF7K7B5R" },
    { "name": "Cloudflare WARP", "bundleId": "com.cloudflare.1dot1dot1dot1.macos", "path": "/Applications/Cloudflare WARP.app", "teamId": "68WVV388M8" },
    { "name": "1Password", "bundleId": "com.1password.1password", "path": "/Applications/1Password.app", "teamId": "2BUA8C4S2C" },
    { "name": "Strada", "bundleId": "com.strada.app", "path": "/Applications/Strada.app", "teamId": "4K8R2Q7XNM" },
    { "name": "Safari", "bundleId": "com.apple.Safari", "path": "/Applications/Safari.app", "teamId": null },
    { "name": "PDF Converter", "bundleId": "com.pdfconverterpro.mac", "path": "/Applications/PDF Converter.app", "teamId": "7XQ2K9M4PL" }
  ],
  "cases": [
    { "label": "benign", "note": "Google updater lives in Application Support, signed by Google's team",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.google.GoogleUpdater.wake.plist", "label": "com.google.GoogleUpdater.wake",
        "program": "/Users/u/Library/Application Support/Google/GoogleUpdater/Current/GoogleUpdater.app/Contents/MacOS/GoogleUpdater", "runAtLoad": true,
        "signature": { "signed": true, "teamId": "EQHXZ8M8AV", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Microsoft AutoUpdate, shared by every Office app",
      "item": { "kind": { "type": "globalAgent" }, "source": "/Library/LaunchAgents/com.microsoft.update.agent.plist", "label": "com.microsoft.update.agent",
        "program": "/Library/Application Support/Microsoft/MAU2.0/Microsoft AutoUpdate.app/Contents/MacOS/Microsoft Update Assistant.app/Contents/MacOS/Microsoft Update Assistant",
        "signature": { "signed": true, "teamId": "UBF8T346G9", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Office licensing privileged helper",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/com.microsoft.office.licensingV2.helper.plist", "label": "com.microsoft.office.licensingV2.helper",
        "program": "/Library/PrivilegedHelperTools/com.microsoft.office.licensingV2.helper",
        "signature": { "signed": true, "teamId": "UBF8T346G9", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Zoom privileged daemon",
      "item": { "kind": { "type": "daemon" }, "source": "/Library/LaunchDaemons/us.zoom.ZoomDaemon.plist", "label": "us.zoom.ZoomDaemon",
        "program": "/Library/PrivilegedHelperTools/us.zoom.ZoomDaemon",
        "signature": { "signed": true, "teamId": "BJ4HAAB9B3", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Zoom updater inside the bundle",
      "item": { "kind": { "type": "globalAgent" }, "source": "/Library/LaunchAgents/us.zoom.updater.plist", "label": "us.zoom.updater",
        "program": "/Applications/zoom.us.app/Contents/Library/LaunchAgents/ZoomUpdater.app/Contents/MacOS/ZoomUpdater",
        "signature": { "signed": true, "teamId": "BJ4HAAB9B3", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Little Snitch root daemon outside the bundle, kept alive",
