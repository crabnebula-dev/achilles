        "signature": { "signed": true, "teamId": null, "apple": false } }, "expect": "bad", "needsJev": true },
    { "label": "malicious", "family": "KeySteal", "note": "Apple-style label for a non-Apple binary",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.apple.googlechrome.plist", "label": "com.apple.googlechrome",
