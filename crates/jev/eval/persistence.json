        "signature": { "signed": true, "teamId": "UBF8T346G9", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Strada helper inside the bundle, kept alive",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/StradaHelper.plist", "label": "StradaHelper",
        "program": "/Applications/Strada.app/Contents/Library/agent-helper", "keepAlive": true,
        "signature": { "signed": true, "teamId": "4K8R2Q7XNM", "apple": false } }, "expect": "normal" },
    { "label": "benign", "note": "Homebrew service: ad-hoc signed, no app",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/homebrew.mxcl.postgresql@16.plist", "label": "homebrew.mxcl.postgresql@16",
