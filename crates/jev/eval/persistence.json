    { "label": "malicious", "family": "Cuckoo", "note": "payload in a hidden dot-folder in the home directory",
      "item": { "kind": { "type": "userAgent" }, "source": "/Users/u/Library/LaunchAgents/com.user.upd.plist", "label": "com.user.upd",
